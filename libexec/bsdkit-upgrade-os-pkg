#!/usr/bin/env zsh

setopt errreturn nounset pipefail

SCRIPT_PATH="$(dirname $(realpath $0))"
SCRIPT_NAME="$(basename $0)"

source ${SCRIPT_PATH}/../lib/system.inc.sh
source ${SCRIPT_PATH}/../lib/colors.inc.sh
source ${SCRIPT_PATH}/../lib/is-yes.inc.sh
source ${SCRIPT_PATH}/../lib/pkgbase.inc.sh

if [ "$(uname -s)" != "FreeBSD" ]; then
    error "Must be executed on FreeBSD."
fi

BSDKIT_PATH="$(realpath ${SCRIPT_PATH}/../)"

export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/bin:/usr/local/sbin

# ===========================================================================

: ${BSDKIT_VERSION:=""}

: ${DESTDIR:=""}
: ${BOOTENV_ENABLE:="default"}
: ${BOOTENV_NAME:="$(date +%F.%H%M)"}
: ${BOOTENV_MOUNT:="/mnt"}
: ${FETCH_ONLY:="no"}
: ${FORCE_UPGRADE:="no"}

: ${_bootenv_created:="no"}
: ${_bootenv_mounted:="no"}
: ${_devfs_mounted:="no"}
: ${_upgrade_done:="no"}
: ${_no_updates:="no"}

# Root the mounts are made under. Kept separate from DESTDIR so cleanup can
# still find them after DESTDIR has been reassigned.
_mount_root=""

_mountpoint_list=()

cleanup() {
    if [ -n "${_mount_root}" ]; then
        for ((i=${#_mountpoint_list[@]}; i>=1; i--)); do
            if ${BSDKIT_PATH}/bsdkit is-mount-point ${_mount_root}${_mountpoint_list[i]}; then
                umount -f ${_mount_root}${_mountpoint_list[i]}
            fi
        done

        if is-yes ${_devfs_mounted}; then
            if ${BSDKIT_PATH}/bsdkit is-mount-point ${_mount_root}/dev; then
                umount -f ${_mount_root}/dev
            fi

            _devfs_mounted="no"
        fi
    fi

    if is-yes ${_bootenv_mounted}; then
        if ${BSDKIT_PATH}/bsdkit is-mount-point ${BOOTENV_MOUNT}; then
            bectl umount -f ${BOOTENV_NAME} > /dev/null 2>&1 || true
        fi

        _bootenv_mounted="no"
    fi

    if is-yes ${_bootenv_created} && ! is-yes ${_upgrade_done}; then
        # A boot environment left behind by a failed run is worse than no boot
        # environment: it is a half-upgraded root that bectl will happily boot.
        # One left by a run that found nothing to do is merely clutter.
        if is-yes ${_no_updates}; then
            message "Removing unused boot environment ${BOOTENV_NAME}"
        else
            warning "Destroying incomplete boot environment ${BOOTENV_NAME}"
        fi

        bectl destroy -F ${BOOTENV_NAME} > /dev/null 2>&1 || true
    fi
}

trap cleanup EXIT

OPTIND=1
while getopts "d:eEfFn:v:" OPT; do
    case ${OPT} in
        d)
            DESTDIR=${OPTARG%/}
            ;;
        e)
            BOOTENV_ENABLE="yes"
            ;;
        E)
            BOOTENV_ENABLE="no"
            ;;
        f)
            FORCE_UPGRADE="yes"
            ;;
        F)
            FETCH_ONLY="yes"
            ;;
        n)
            BOOTENV_NAME=${OPTARG}
            ;;
        v)
            BSDKIT_VERSION=${OPTARG}
            ;;
        *)
            exit 64 # EX_USAGE
            ;;
    esac
done

shift $((OPTIND - 1))

if [ -d ${DESTDIR}/.base ]; then
    error "Destination directory is thin jail"
fi

# A jail has no boot environments: it has no loader to select one, and the
# dataset holding its root belongs to the host. A root that was not itself
# booted from a boot environment has none to clone either.

_bootenv_reason=""

if is-jailed; then
    _bootenv_reason="running in a jail"
elif ! kenv -q zfs_be_root > /dev/null 2>&1; then
    _bootenv_reason="root filesystem is not a ZFS boot environment"
fi

if [ -n "${_bootenv_reason}" ]; then
    # Silently falling back would upgrade the live root when the caller asked
    # for the isolation of a boot environment, which is the opposite of what
    # they asked for.
    if is-yes ${BOOTENV_ENABLE}; then
        error "cannot use a boot environment: ${_bootenv_reason}"
    fi

    BOOTENV_ENABLE="no"
fi

if [ "${BOOTENV_ENABLE}" = "default" ]; then
    if [ -z "${DESTDIR}" ]; then
        BOOTENV_ENABLE="yes"
    else
        BOOTENV_ENABLE="no"
    fi
fi

if [ -n "${DESTDIR}" ] && is-yes ${BOOTENV_ENABLE}; then
    error "incompatible BOOTENV_ENABLE and DESTDIR"
fi

if is-yes ${BOOTENV_ENABLE}; then
    which bectl > /dev/null 2>&1 || error "missing requirement: bectl"
fi

# ---------------------------------------------------------------------------
# The base system must already be under package management. Running this on a
# tarball system would install a parallel set of base packages over unmanaged
# files; running it on a partially converted one would advance only half the
# system.

_install_type=$(get-install-type ${DESTDIR})

case ${_install_type} in
    pkgbase)
        ;;

    tarball)
        error "Base system is tarball-based, use 'bsdkit upgrade-os' instead"
        ;;

    *)
        error "Base system is '${_install_type}', refusing to upgrade"
        ;;
esac

if [ -z "${BSDKIT_VERSION}" ]; then
    BSDKIT_VERSION="$(get-os-version ${DESTDIR:-/})"
    message "Using current version: ${BSDKIT_VERSION}"
fi

if [ "${BSDKIT_VERSION}" = "${BSDKIT_VERSION#*.}" ]; then
    error "Version must be major.minor, e.g. 15.1 (got '${BSDKIT_VERSION}')"
fi

_current_version="$(get-os-version ${DESTDIR:-/})"
_current_major=${_current_version%%.*}
_target_major=${BSDKIT_VERSION%%.*}

# pkg derives ABI from the running system and the pkgbase signing keys are
# per-major, so a major jump cannot be driven from the running root.
if [ "${_current_major}" != "${_target_major}" ]; then
    error "Cannot cross major versions (${_current_version} -> ${BSDKIT_VERSION})"
fi

message "Current release is $(get-osrelease ${DESTDIR:-/})"
message "Target release is ${BSDKIT_VERSION}"

# ---------------------------------------------------------------------------

if is-yes ${BOOTENV_ENABLE}; then
    if mount | cut -w -f 3 | fgrep -q "${BOOTENV_MOUNT}"; then
        error "mount point '${BOOTENV_MOUNT}' already in use"
    fi

    message "Creating boot environment ${BOOTENV_NAME}"

    bectl create ${BOOTENV_NAME}
    _bootenv_created="yes"

    bectl mount ${BOOTENV_NAME} ${BOOTENV_MOUNT} > /dev/null 2>&1
    _bootenv_mounted="yes"

    DESTDIR=${BOOTENV_MOUNT}
elif [ -n "${DESTDIR}" ]; then
    # Only meaningful for a directory that is a mounted dataset in its own
    # right; zfs is allowed to be unavailable, as it is in a jail.
    _destdir_fs=$(zfs list -H -o mounted,mountpoint,name 2> /dev/null \
        | awk "\$1 == \"yes\" && \$2 == \"${DESTDIR}\" { print \$3; }") || _destdir_fs=""

    if [ -n "${_destdir_fs}" ]; then
        zfs snapshot "${_destdir_fs}@$(date +%F.%H%M)"
    fi
else
    warning "Upgrading the running system in place${_bootenv_reason:+ (${_bootenv_reason})}"
fi

# ---------------------------------------------------------------------------
# The environment is upgraded through a chroot, so it needs the same
# filesystems the running system has: the directories package scripts expect,
# and devfs for anything that opens /dev.

if [ -n "${DESTDIR}" ]; then
    _mount_root=${DESTDIR}

    if mount | cut -w -f 3 | fgrep -q "/usr/src"; then
        _mountpoint_list+=("/usr/src")
    fi

    if mount | cut -w -f 3 | fgrep -q "/usr/ports"; then
        _mountpoint_list+=("/usr/ports")
    fi

    mount -p | awk '$2 ~ "^/var(/|$)" { print $2 }' | while read _mountpoint; do
        _mountpoint_list+=(${_mountpoint})
    done

    for ((i=1; i<=${#_mountpoint_list[@]}; i++)); do
        mount -t nullfs ${_mountpoint_list[i]} ${_mount_root}${_mountpoint_list[i]}
    done

    mount -t devfs devfs ${_mount_root}/dev
    _devfs_mounted="yes"

    # Checked after the mounts, because a nullfs mount of a separate /var is
    # exactly what would drag the running system's package database in here.
    # Resolution happens inside the chroot so that an absolute symlink such as
    # /var/db/pkg -> /usr/local/pkg is followed the way pkg will follow it.
    _pkg_dbdir=$(pkg config PKG_DBDIR 2> /dev/null) || _pkg_dbdir="/var/db/pkg"

    _real_dbdir=$(chroot ${DESTDIR} realpath -q ${_pkg_dbdir}) \
        || error "package database ${_pkg_dbdir} cannot be resolved under ${DESTDIR}"

    _root_dataset=$(df ${DESTDIR} | awk 'NR == 2 { print $1 }')
    _pkgdb_dataset=$(df ${DESTDIR}${_real_dbdir} | awk 'NR == 2 { print $1 }')

    if [ "${_root_dataset}" != "${_pkgdb_dataset}" ]; then
        error "package database ${_real_dbdir} (${_pkgdb_dataset}) is outside ${DESTDIR} (${_root_dataset})"
    fi
fi

# ---------------------------------------------------------------------------

_repo_file=${DESTDIR}/usr/local/etc/pkg/repos/FreeBSD.conf

_repo_url=$(get-pkgbase-repo-url ${BSDKIT_VERSION} ${DESTDIR})

message "Pointing FreeBSD-base at ${_repo_url}"

set-pkgbase-repo-url ${_repo_file} ${_repo_url} ${_target_major}

local -a _pkg
_pkg=(pkg)

if [ -n "${DESTDIR}" ]; then
    # -c rather than -r: pkg -r prepends a root but does not chroot, so it
    # reads the host's repository configuration and follows absolute symlinks
    # out of the target. Chrooting makes both resolve inside the environment.
    _pkg=(pkg -c ${DESTDIR})
fi

# The repository URL changed, so the cached catalogue is stale. Without -f pkg
# reports "up to date" against the previous catalogue and upgrades nothing.
message "Updating FreeBSD-base catalogue"
${_pkg[@]} update -f -r FreeBSD-base

if is-yes ${FETCH_ONLY}; then
    message "Fetching packages"
    ${_pkg[@]} fetch -y -u -r FreeBSD-base
    message "Packages downloaded successfully"
    _upgrade_done="yes"
    exit 0
fi

if ! is-yes ${FORCE_UPGRADE}; then
    if ${_pkg[@]} upgrade -n -r FreeBSD-base 2>&1 | fgrep -q "Your packages are up to date"; then
        message "No updates available for ${BSDKIT_VERSION}"
        _no_updates="yes"
        exit 0
    fi
fi

message "Upgrading base packages"
${_pkg[@]} upgrade -y -r FreeBSD-base

_upgrade_done="yes"

if is-yes ${BOOTENV_ENABLE}; then
    cleanup

    bectl activate ${BOOTENV_NAME}
    bectl list

    message "Upgrade complete, reboot into ${BOOTENV_NAME} to apply."
else
    message "Upgrade complete."
fi
