#!/usr/bin/env zsh

setopt errreturn nounset pipefail

SCRIPT_PATH="$(dirname $(realpath $0))"
SCRIPT_NAME="$(basename $0)"

source ${SCRIPT_PATH}/../lib/system.inc.sh
source ${SCRIPT_PATH}/../lib/colors.inc.sh
source ${SCRIPT_PATH}/../lib/hr-to-bytes.inc.sh
source ${SCRIPT_PATH}/../lib/is-yes.inc.sh
source ${SCRIPT_PATH}/../lib/yaml.inc.sh

if [ "$(uname -s)" != "FreeBSD" ]; then
    error "Must be executed on FreeBSD."
fi

BSDKIT_PATH="$(realpath ${SCRIPT_PATH}/../)"

if [ "$(whoami)" != "root" ]; then
    error "Must be executed as root."
fi

# ===========================================================================

DEFAULT_VERSION=15.1
DEFAULT_ARCH=amd64

VERSION="${DEFAULT_VERSION}"
ARCH="${DEFAULT_ARCH}"

usage() {
    echo "usage: ${SCRIPT_NAME} [-v VERSION] [-a ARCH] {build|extras|copy|verify|clean}" >&2
    exit 2
}

OPTIND=1
while getopts "v:a:" OPT; do
    case ${OPT} in
        v) VERSION="${OPTARG}" ;;
        a) ARCH="${OPTARG}" ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

SCRATCH="/scratch/${VERSION}"
SRC_SRC="${BSDKIT_DATA}/src/${VERSION}/src"
SRC_PORTS="/usr/ports"

RELEASE_DEST="${BSDKIT_DATA}/release-${VERSION}-${ARCH}"

RELEASE_DIR="${SRC_SRC}/release"
RELEASE_SAMPLE="${RELEASE_DIR}/release.conf.sample"
RELEASE_CONF=""

generate-release-conf() {
    RELEASE_CONF=$(mktemp -t "release-${VERSION}.conf")
    message "Generating release conf at ${RELEASE_CONF}"
    {
        cat "${RELEASE_SAMPLE}"
        cat <<EOF

## --- overrides from ${SCRIPT_NAME} ---
CHROOTDIR="${SCRATCH}"
## TARGET is uname -m, TARGET_ARCH is uname -p; identical for amd64,
## aarch64, riscv64. For split arches (arm/armv7, powerpc/powerpc64)
## these differ, so -a's single value would be wrong -- handle then.
TARGET="${ARCH}"
TARGET_ARCH="${ARCH}"
SRCBRANCH="releng/${VERSION}"
SRC_UPDATE_SKIP=1
NOGIT=1
NOPORTS=1
WITH_COMPRESSED_IMAGES=1
WITH_VMIMAGES=1
WITH_COMPRESSED_VMIMAGES=1
WITH_CLOUDWARE=1
CLOUDWARE="BASIC-CLOUDINIT VAGRANT-VIRTUALBOX"

## Workaround for Makefile.vm:108 invariant. release.sh propagates both
## NO_ROOT=1 and WITHOUT_QEMU=1 as MAKEOVERRIDES when NO_ROOT is set,
## which keeps them in sync across deep sub-makes (e.g. usr.sbin/pkg's
## \`make -C release -V BRANCH\` query during installworld).
NO_ROOT=1
EOF
    } > "${RELEASE_CONF}"
}

## release/Makefile targets (base.txz, src.txz, disc1.iso, ...) are plain
## file targets with no dependencies: if they already exist in the obj
## tree from an earlier build they are silently reused, while OSRELEASE
## (image names), RELEASE, OLDFILES and etcupdate.tar.bz2 are taken from
## the current source tree. Building on top of a previous build therefore
## produces old bits under new names, so refuse unless the scratch is clean.
check-scratch-clean() {
    local _stale=""
    local _path
    for _path in usr/obj tmp/obj bin/sh; do
        if [ -e "${SCRATCH}/${_path}" ]; then
            _stale="${_stale} ${SCRATCH}/${_path}"
        fi
    done
    if [ -n "${_stale}" ]; then
        warning "Leftovers from a previous build found:${_stale}"
        error "Refusing to build on top of a previous build; run '${SCRIPT_NAME} clean' first"
    fi

    ## 'make install DESTDIR=/R' copies into an existing R/ without
    ## removing anything, so images from a previous patch level would
    ## survive next to the new ones. Start from an empty R/.
    if [ -e "${SCRATCH}/R" ]; then
        message "Removing previous build output ${SCRATCH}/R"
        chflags -R noschg "${SCRATCH}/R"
        rm -rf "${SCRATCH}/R"
    fi
}

## 15.1-RELEASE-p2 from a newvers.sh read on stdin.
osrelease-from-newvers() {
    local _contents=$(cat)
    local _revision=$(echo "${_contents}" | grep -oE '^REVISION="([^"]+)"' | cut -d'"' -f2)
    local _branch=$(echo "${_contents}" | grep -oE '^BRANCH="([^"]+)"' | cut -d'"' -f2)
    [ -n "${_revision}" ] && [ -n "${_branch}" ] || return 1
    echo "${_revision}-${_branch}"
}

## 15.1-RELEASE-p2 from the bin/freebsd-version inside a tarball or ISO.
osrelease-from-archive() {
    local _archive=$1
    local _member=$2
    tar -xOf "${_archive}" "${_member}" 2>/dev/null |
        sed -n 's/^USERLAND_VERSION="\([^"]*\)"$/\1/p'
}

## Make sure everything in the release tree carries the version the
## source tree claims, i.e. nothing was reused from an older build.
verify-release() {
    local _dir=$1
    local _expected=$(get-src-osrelease "${SRC_SRC}")
    local _failed=0
    local _actual

    message "Verifying ${_dir} against source tree version ${_expected}"

    check-one() {
        local _what=$1
        local _actual=$2
        if [ "${_actual}" = "${_expected}" ]; then
            message "  ${_what}: ${_actual}"
        else
            warning "  ${_what}: ${_actual:-unknown} (expected ${_expected})"
            _failed=1
        fi
    }

    local _base="${_dir}/ftp/base.txz"
    if [ -f "${_base}" ]; then
        check-one "ftp/base.txz" "$(osrelease-from-archive "${_base}" ./bin/freebsd-version)"
    else
        warning "  ftp/base.txz: missing"
        _failed=1
    fi

    local _src="${_dir}/ftp/src.txz"
    if [ -f "${_src}" ]; then
        _actual=$(tar -xOf "${_src}" usr/src/sys/conf/newvers.sh 2>/dev/null | osrelease-from-newvers || true)
        check-one "ftp/src.txz" "${_actual}"
    fi

    local _image
    for _image in disc1.iso bootonly.iso; do
        local _iso="${_dir}/FreeBSD-${_expected}-${ARCH}-${_image}"
        if [ -f "${_iso}" ]; then
            check-one "${_iso:t}" "$(osrelease-from-archive "${_iso}" bin/freebsd-version)"
        else
            warning "  ${_iso:t}: missing"
            _failed=1
        fi
    done

    local _release_file="${_dir}/ftp/RELEASE"
    if [ -f "${_release_file}" ]; then
        check-one "ftp/RELEASE" "$(<"${_release_file}")"
    fi

    if [ ${_failed} -ne 0 ]; then
        error "Release tree ${_dir} does not match source tree version ${_expected}"
    fi
    message "Release tree ${_dir} verified as ${_expected}"
}

setup() {
    message "Preparing scratch directories under ${SCRATCH}"
    mkdir -p "${SCRATCH}/usr/src" "${SCRATCH}/usr/ports"

    [ -d "${SRC_SRC}" ]   || error "Source directory ${SRC_SRC} does not exist"
    [ -d "${SRC_PORTS}" ] || error "Ports directory ${SRC_PORTS} does not exist"

    nullfs-mount "${SRC_SRC}"   "${SCRATCH}/usr/src"
    nullfs-mount "${SRC_PORTS}" "${SCRATCH}/usr/ports"

    generate-release-conf
}

teardown() {
    message "Tearing down mounts"
    unmount-if-mounted "${SCRATCH}/dev"
    unmount-if-mounted "${SCRATCH}/usr/ports"
    unmount-if-mounted "${SCRATCH}/usr/src"

    if [ -n "${RELEASE_CONF}" ] && [ -f "${RELEASE_CONF}" ]; then
        message "Removing generated conf ${RELEASE_CONF}"
        rm -f "${RELEASE_CONF}"
    fi
}

build-extras() {
    message "Generating RELEASE file"
    get-src-osrelease "${SRC_SRC}" > "${SCRATCH}/R/ftp/RELEASE"

    message "Building etcupdate tarball"
    etcupdate build -s "${SRC_SRC}" "${SCRATCH}/R/ftp/etcupdate.tar.bz2"

    message "Generating OLDFILES list"
    local _oldfiles="${SCRATCH}/R/ftp/OLDFILES"
    : > "${_oldfiles}"
    make -s -C "${SRC_SRC}" list-old-files | sed 's/^/old-files: /' >> "${_oldfiles}"
    make -s -C "${SRC_SRC}" list-old-dirs  | sed 's/^/old-dirs: /'  >> "${_oldfiles}"
    make -s -C "${SRC_SRC}" list-old-libs  | sed 's/^/old-libs: /'  >> "${_oldfiles}"
}

cmd-build() {
    trap teardown EXIT INT TERM

    check-scratch-clean

    setup

    message "Running release build with ${RELEASE_CONF}"
    "${RELEASE_DIR}/release.sh" -c "${RELEASE_CONF}"

    build-extras

    verify-release "${SCRATCH}/R"

    copy-release

    message "Release build complete"
}

cmd-extras() {
    if [ ! -d "${SCRATCH}/R/ftp" ]; then
        error "${SCRATCH}/R/ftp does not exist; run '${SCRIPT_NAME} build' first"
    fi
    build-extras
}

copy-release() {
    message "Copying ${SCRATCH}/R/ to ${RELEASE_DEST}/"
    mkdir -p "${RELEASE_DEST}"
    ## --delete drops leftovers from previous releases, so the target
    ## always mirrors the current build exactly.
    rsync -av --delete "${SCRATCH}/R/" "${RELEASE_DEST}/"
    message "Copy complete"
}

cmd-copy() {
    if [ ! -d "${SCRATCH}/R" ]; then
        error "${SCRATCH}/R does not exist; run '${SCRIPT_NAME} build' first"
    fi
    verify-release "${SCRATCH}/R"
    copy-release
}

cmd-verify() {
    if [ ! -d "${RELEASE_DEST}" ]; then
        error "${RELEASE_DEST} does not exist"
    fi
    verify-release "${RELEASE_DEST}"
}

cmd-clean() {
    message "Unmounting any stale build mounts under ${SCRATCH}"
    unmount-if-mounted "${SCRATCH}/dev"
    unmount-if-mounted "${SCRATCH}/usr/ports"
    unmount-if-mounted "${SCRATCH}/usr/src"

    local _found=$(mounts-strictly-under "${SCRATCH}")
    if [ -n "${_found}" ]; then
        warning "Unexpected mounts present under ${SCRATCH}:"
        echo "${_found}" >&2
        error "Refusing to clean"
    fi

    if [ ! -d "${SCRATCH}" ]; then
        message "Nothing to clean: ${SCRATCH} does not exist"
        return 0
    fi

    message "Clearing schg flags under ${SCRATCH} (preserving R/)"
    find "${SCRATCH}" -mindepth 1 -maxdepth 1 ! -name R -exec chflags -R noschg {} +

    message "Removing ${SCRATCH} contents (preserving R/)"
    find "${SCRATCH}" -mindepth 1 -maxdepth 1 ! -name R -exec rm -rf {} +
    message "Clean complete"
}

[ $# -eq 1 ] || usage
case $1 in
    build)  cmd-build ;;
    extras) cmd-extras ;;
    copy)   cmd-copy ;;
    verify) cmd-verify ;;
    clean)  cmd-clean ;;
    *)      usage ;;
esac
