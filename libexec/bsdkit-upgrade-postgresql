#!/usr/bin/env zsh

setopt errreturn nounset pipefail

SCRIPT_PATH="$(dirname $(realpath $0))"
SCRIPT_NAME="$(basename $0)"

source ${SCRIPT_PATH}/../lib/system.inc.sh
source ${SCRIPT_PATH}/../lib/colors.inc.sh
source ${SCRIPT_PATH}/../lib/hr-to-bytes.inc.sh
source ${SCRIPT_PATH}/../lib/is-yes.inc.sh
source ${SCRIPT_PATH}/../lib/postgresql.inc.sh
source ${SCRIPT_PATH}/../lib/yaml.inc.sh

if [ "$(uname -s)" != "FreeBSD" ]; then
    error "Must be executed on FreeBSD."
fi

BSDKIT_PATH="$(realpath ${SCRIPT_PATH}/../)"

if [ -x /usr/local/bin/vim ]; then
    export EDITOR=/usr/local/bin/vim
fi

# ===========================================================================

usage() {
    echo "Usage: ${SCRIPT_NAME} -s <source version> -t <target version>"
    exit 0
}

# The standby's primary_conninfo is the authoritative description of how to
# reach the primary, so read it whole and keep it, rather than rebuilding it
# from the handful of fields this script happens to care about.
# postgresql.auto.conf wraps the value in single quotes and doubles any quote
# inside it.
primary-conninfo() {
    local _line
    local _value

    _line=$(grep -E "^primary_conninfo[[:space:]]*=" "${SOURCE_PGDATA}/postgresql.auto.conf" | tail -1) || :

    _value=$(print -r -- "${_line}" | sed -E 's/^primary_conninfo[[:space:]]*=[[:space:]]*//')

    if [[ ${_value} == \'*\' ]]; then
        _value=${_value[2,-2]}
        _value=${_value//\'\'/\'}
    fi

    print -r -- "${_value}"
}

# Pull a single field (host, port, user, password, ...) out of a conninfo
# string. The leading space in the subject anchors the field name on a word
# boundary, so a request for "password" cannot match "sslpassword". A value
# holding spaces or quotes is wrapped in single quotes by libpq, which escapes
# a quote or a backslash inside it with a backslash; this is a separate layer
# from the quote doubling that primary-conninfo already undid.
primary-conninfo-field() {
    local _field="$1"
    local _conn_info=" $2"
    local _quote="'"
    local _quoted="[[:space:]]${_field}=${_quote}((\\\\.|[^${_quote}\\\\])*)${_quote}"
    local _bare="[[:space:]]${_field}=((\\\\.|[^[:space:]\\\\])+)"

    if [[ ${_conn_info} =~ ${_quoted} ]]; then
        print -r -- "${match[1]}" | sed -E 's/\\(.)/\1/g'
    elif [[ ${_conn_info} =~ ${_bare} ]]; then
        print -r -- "${match[1]}" | sed -E 's/\\(.)/\1/g'
    fi
}

# A backslash or a colon inside any .pgpass field has to be escaped.
pgpass-escape() {
    local _value="$1"

    _value=${_value//\\/\\\\}
    _value=${_value//:/\\:}

    print -r -- "${_value}"
}

# Hand the primary's password to pg_basebackup through a password file instead
# of the command line or the connection string: process arguments are readable
# by any local user through ps(1). Only the contents are sensitive, not the
# path, so PGPASSFILE can be passed openly.
PRIMARY_PASSFILE=""

create-primary-passfile() {
    local _host=$(pgpass-escape "$1")
    local _port=$(pgpass-escape "$2")
    local _user=$(pgpass-escape "$3")
    local _password=$(pgpass-escape "$4")

    PRIMARY_PASSFILE=$(mktemp -t bsdkit-pgpass)
    chmod 600 "${PRIMARY_PASSFILE}"
    print -r -- "${_host}:${_port}:*:${_user}:${_password}" > "${PRIMARY_PASSFILE}"
    chown ${POSTGRES_USER} "${PRIMARY_PASSFILE}"
}

remove-primary-passfile() {
    if [ -n "${PRIMARY_PASSFILE}" ]; then
        rm -f "${PRIMARY_PASSFILE}"
        PRIMARY_PASSFILE=""
    fi
}

trap remove-primary-passfile EXIT INT TERM

# Fail fast if the postgres user cannot reach the primary over SSH. Both the
# base backup follow-up (SSL file copy) and any manual recovery depend on it, so
# it is better to stop up front than partway through the upgrade. Also seeds
# known_hosts so the later scp runs non-interactively.
check-primary-ssh() {
    local _host="$1"

    message "Checking SSH connectivity to primary ${_host}"

    if ! su ${POSTGRES_USER} -c "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -i ~${POSTGRES_USER}/.ssh/id_ed25519 ${POSTGRES_USER}@${_host} true"; then
        error "Cannot reach primary ${_host} over SSH as ${POSTGRES_USER}. Configure key-based auth (~${POSTGRES_USER}/.ssh/id_ed25519) before upgrading the replica."
    fi
}

perform-pg-basebackup() {
    if postgresql-is-running ${SOURCE_BINDIR} ${SOURCE_LIBDIR} ${SOURCE_PGDATA}; then
        error "PostgreSQL is running. Please stop it first."
    fi

    local _conn_info=$(primary-conninfo)

    local _host=$(primary-conninfo-field host "${_conn_info}")
    local _port=$(primary-conninfo-field port "${_conn_info}")
    local _user=$(primary-conninfo-field user "${_conn_info}")
    local _password=$(primary-conninfo-field password "${_conn_info}")

    if [ -z "${_host}" ]; then
        error "No host defined in ${SOURCE_PGDATA}/postgresql.auto.conf"
    fi

    if [ -z "${_port}" ]; then
        error "No port defined in ${SOURCE_PGDATA}/postgresql.auto.conf"
    fi

    if [ -z "${_user}" ]; then
        error "No user defined in ${SOURCE_PGDATA}/postgresql.auto.conf"
    fi

    message "Performing pg_basebackup with host=${_host}, port=${_port}, user=${_user}"

    local _environment="LD_LIBRARY_PATH=${TARGET_LIBDIR}"

    if [ -n "${_password}" ]; then
        create-primary-passfile "${_host}" "${_port}" "${_user}" "${_password}"
        _environment="${_environment} PGPASSFILE=${PRIMARY_PASSFILE}"
    fi

    # --no-password turns a missing or rejected credential into an immediate
    # failure instead of a password prompt that blocks the upgrade on a tty.
    _options=(
        "--pgdata=${TARGET_PGDATA}"
        "--wal-method=stream"
        "--progress"
        "--verbose"
        "--write-recovery-conf"
        "--no-password"
        "--host=${_host}"
        "--username=${_user}"
        "--port=${_port}"
    )

    if ! su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && ${_environment} ${TARGET_BINDIR}/pg_basebackup ${_options}"; then
        remove-primary-passfile
        error "pg_basebackup failed. Remove the incomplete ${TARGET_PGDATA} before retrying."
    fi

    remove-primary-passfile

    restore-primary-conninfo "${_conn_info}"

    sync-primary-ssl-files "${_host}"
}

# pg_basebackup --write-recovery-conf regenerates primary_conninfo from the
# parameters it was handed, so everything the original connection string
# carried beyond host, port and user is lost, including the password the new
# standby needs to reconnect once the upgrade is over. Put the original line
# back verbatim. The redirection into the existing file keeps the ownership and
# the mode that pg_basebackup gave it.
restore-primary-conninfo() {
    local _conn_info="$1"
    local _auto_conf="${TARGET_PGDATA}/postgresql.auto.conf"
    local _quote="'"
    local _temporary_file
    local _quoted

    message "Restoring the original primary_conninfo in the new cluster"

    # Re-apply the quote doubling that primary-conninfo undid when it read the
    # value out of the source postgresql.auto.conf.
    _quoted=${_conn_info//${_quote}/${_quote}${_quote}}

    _temporary_file=$(mktemp -t bsdkit-auto-conf)

    { grep -v -E "^primary_conninfo[[:space:]]*=" "${_auto_conf}" || : ; } > "${_temporary_file}"
    print -r -- "primary_conninfo = ${_quote}${_quoted}${_quote}" >> "${_temporary_file}"

    cat "${_temporary_file}" > "${_auto_conf}"
    rm -f "${_temporary_file}"
}

# pg_basebackup copies the primary's configuration, which may enable SSL and
# reference certificate files that live outside PGDATA (typically in ~postgres).
# Those files are not part of the base backup, so copy the ones the new cluster
# needs from the primary. Both hosts share the same postgres home directory and
# mutual key-based SSH auth for the postgres user, so the absolute paths and the
# identity file match on both sides.
sync-primary-ssl-files() {
    local _host="$1"

    local _ssl_enabled
    _ssl_enabled=$(su ${POSTGRES_USER} -c "LD_LIBRARY_PATH=${TARGET_LIBDIR} ${TARGET_BINDIR}/postgres -D ${TARGET_PGDATA} -C ssl")

    if [ "${_ssl_enabled}" != "on" ]; then
        return 0
    fi

    local _param _path _output

    for _param in ssl_cert_file ssl_key_file ssl_ca_file ssl_crl_file; do
        _path=$(su ${POSTGRES_USER} -c "LD_LIBRARY_PATH=${TARGET_LIBDIR} ${TARGET_BINDIR}/postgres -D ${TARGET_PGDATA} -C ${_param}")

        # Skip unset parameters and relative paths: relative paths resolve inside
        # PGDATA and were already copied by pg_basebackup.
        [ -n "${_path}" ] || continue
        case "${_path}" in
            /*) ;;
            *) continue ;;
        esac

        # Nothing to do if the file is already present locally.
        [ -f "${_path}" ] && continue

        message "Copying ${_param} (${_path}) from primary ${_host}"

        if ! _output=$(su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && scp -p -o BatchMode=yes -o StrictHostKeyChecking=accept-new -i ~${POSTGRES_USER}/.ssh/id_ed25519 ${POSTGRES_USER}@${_host}:${_path} ${_path}" 2>&1); then
            [ -n "${_output}" ] && print -r -- "${_output}" >&2
            error "Failed to copy ${_param} (${_path}) from primary ${_host}. Copy it manually and re-run."
        fi
    done
}

stop-old-cluster() {
    message "Stopping old cluster"
    su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && LD_LIBRARY_PATH=${SOURCE_LIBDIR} ${SOURCE_BINDIR}/pg_ctl stop -D ${SOURCE_PGDATA}" || :
}

stop-new-cluster() {
    message "Stopping new cluster"
    su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && LD_LIBRARY_PATH=${TARGET_LIBDIR} ${TARGET_BINDIR}/pg_ctl stop -D ${TARGET_PGDATA}" || :
}

start-old-cluster() {
    message "Starting old cluster"
    su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && LD_LIBRARY_PATH=${SOURCE_LIBDIR} ${SOURCE_BINDIR}/pg_ctl start -D ${SOURCE_PGDATA}" || :
}

start-new-cluster() {
    message "Starting new cluster"
    su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && LD_LIBRARY_PATH=${TARGET_LIBDIR} ${TARGET_BINDIR}/pg_ctl start -D ${TARGET_PGDATA}" || :
}

perform-pg-upgrade() {
    if postgresql-is-running ${SOURCE_BINDIR} ${SOURCE_LIBDIR} ${SOURCE_PGDATA}; then
        error "PostgreSQL is running. Please stop it first."
    fi

    # start-old-cluster ignores the exit status of pg_ctl, so confirm the
    # postmaster is really up before reading the settings that decide how the
    # new cluster gets initialised.
    start-old-cluster

    if ! postgresql-is-running ${SOURCE_BINDIR} ${SOURCE_LIBDIR} ${SOURCE_PGDATA}; then
        error "The old cluster did not start; cannot read its settings."
    fi

    # to restart the old cluster:
    # su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && ${SOURCE_BINDIR}/pg_ctl stop -D ${SOURCE_PGDATA}" || :
    # su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && ${SOURCE_BINDIR}/pg_ctl start -D ${SOURCE_PGDATA}" || :

    _initdb_flags=()

    _lc_collate=$(LD_LIBRARY_PATH=${SOURCE_LIBDIR} ${SOURCE_BINDIR}/psql --username=${POSTGRES_USER} --tuples-only --command "SHOW lc_collate" ${TEMPLATE_DATABASE})
    _lc_ctype=$(LD_LIBRARY_PATH=${SOURCE_LIBDIR} ${SOURCE_BINDIR}/psql --username=${POSTGRES_USER} --tuples-only --command "SHOW lc_ctype" ${TEMPLATE_DATABASE})
    _encoding=$(LD_LIBRARY_PATH=${SOURCE_LIBDIR} ${SOURCE_BINDIR}/psql --username=${POSTGRES_USER} --tuples-only --command "SHOW server_encoding" ${TEMPLATE_DATABASE})
    _data_checksums=$(LD_LIBRARY_PATH=${SOURCE_LIBDIR} ${SOURCE_BINDIR}/psql --username=${POSTGRES_USER} --tuples-only --command "SHOW data_checksums" ${TEMPLATE_DATABASE})

    stop-old-cluster

    _lc_collate=${_lc_collate// /}
    _lc_ctype=${_lc_ctype// /}
    _encoding=${_encoding// /}
    _data_checksums=${_data_checksums// /}

    _initdb_flags+=("--lc-collate=${_lc_collate}")
    _initdb_flags+=("--lc-ctype=${_lc_ctype}")
    _initdb_flags+=("--encoding=${_encoding}")

    # Match the source cluster's checksum setting. PostgreSQL 18 flipped the
    # initdb default to enabled, so the flag must be forced or pg_upgrade
    # refuses a cluster whose checksum state differs from the source. Both the
    # new default and the --no-data-checksums option arrived in 18, so the
    # opt-out is only passed to a target of 18 or later.
    if [ "${_data_checksums}" = "on" ]; then
        _initdb_flags+=("--data-checksums")
    elif [ ${TARGET_VERSION} -ge 18 ]; then
        _initdb_flags+=("--no-data-checksums")
    fi

    message "Initializing new database"

    if ! su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && ${TARGET_BINDIR}/initdb ${_initdb_flags} --pgdata ${TARGET_PGDATA} --username ${POSTGRES_USER}"; then
        error "initdb failed. Remove the incomplete ${TARGET_PGDATA} before retrying."
    fi

    if [ -f ${SOURCE_PGDATA}/pg_hba.conf ]; then
        message "Copying pg_hba.conf"
        cp -p -v ${SOURCE_PGDATA}/pg_hba.conf ${TARGET_PGDATA}/pg_hba.conf
    fi

    if [ -f ${SOURCE_PGDATA}/postgresql.auto.conf ]; then
        message "Copying postgresql.auto.conf"
        cp -p -v ${SOURCE_PGDATA}/postgresql.auto.conf ${TARGET_PGDATA}/postgresql.auto.conf
    fi

    _options=(
        "--old-bindir=${SOURCE_BINDIR}"
        "--new-bindir=${TARGET_BINDIR}"
        "--old-datadir=${SOURCE_PGDATA}"
        "--new-datadir=${TARGET_PGDATA}"
        "--link"
        "--username=${POSTGRES_USER}"
    )

    message "Checking cluster compatibility"

    if ! su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && ${TARGET_BINDIR}/pg_upgrade ${_options} --check"; then
        error "pg_upgrade --check failed. The old cluster in ${SOURCE_PGDATA} is untouched."
    fi

    message "Upgrading cluster"

    # Past this point --link has hard-linked the old cluster's files into the
    # new one, so a failure leaves ${SOURCE_PGDATA} unusable as well.
    if ! su ${POSTGRES_USER} -c "cd ~${POSTGRES_USER} && ${TARGET_BINDIR}/pg_upgrade ${_options}"; then
        error "pg_upgrade failed. Consult the logs in ~${POSTGRES_USER} before retrying; the old cluster can no longer be started."
    fi

    rm -f -v /tmp/.s.PGSQL.*(N)

    message "Starting new cluster"
    start-new-cluster

    if [ -f /var/db/postgres/update_extensions.sql ]; then
        su ${POSTGRES_USER} -c "cd ~postgres && LD_LIBRARY_PATH=${TARGET_LIBDIR} ${TARGET_BINDIR}/psql < ~postgres/update_extensions.sql"
    fi

    message "Running vacuumdb"
    su ${POSTGRES_USER} -c "cd ~postgres && LD_LIBRARY_PATH=${TARGET_LIBDIR} ${TARGET_BINDIR}/vacuumdb --all --analyze-in-stages"

    message "Stopping new cluster"
    stop-new-cluster

    message "Removing helper files"
    rm -f ~postgres/analyze_new_cluster.sh
    rm -f ~postgres/delete_old_cluster.sh
    rm -f ~postgres/update_extensions.sql

    rm -f ~postgres/pg_upgrade_internal.log
    rm -f ~postgres/pg_upgrade_server.log
    rm -f ~postgres/pg_upgrade_utility.log
}

fetch-package() {
    local _package="$1"
    local _output

    if ! _output=$(pkg fetch -y -o /tmp/ "${_package}" 2>&1); then
        [ -n "${_output}" ] && print -r -- "${_output}" >&2
        error "Failed to fetch package ${_package}."
    fi
}

extract-package() {
    local _prefix="$1"
    local _package="$2"
    local _output

    local _files=(/tmp/All/${_package}*(N))

    if [ ${#_files} -eq 0 ]; then
        error "No downloaded archive found for package ${_package}."
    fi

    if ! _output=$(tar -x -f ${_files[1]} -C ${_prefix} 2>&1); then
        [ -n "${_output}" ] && print -r -- "${_output}" >&2
        error "Failed to extract package ${_package}."
    fi
}

perform-package-upgrade() {
    _is_source_contrib_installed=$(pkg query -g %n "postgresql${SOURCE_VERSION}-contrib" || :)

    for _package in $(pkg query -g %n "postgresql${SOURCE_VERSION}-*"); do
        message "Changing name of ${_package} to postgresql${TARGET_VERSION}${_package#postgresql${SOURCE_VERSION}}"
        pkg set -y --change-name ${_package}:postgresql${TARGET_VERSION}${_package#postgresql${SOURCE_VERSION}}
    done

    message "Upgrading packages"
    pkg upgrade --yes --glob postgresql\*

    _is_target_contrib_installed=$(pkg query -g %n "postgresql${TARGET_VERSION}-contrib" || :)

    if [ -n "${_is_source_contrib_installed}" ] && [ -z "${_is_target_contrib_installed}" ]; then
        message "Installing contrib"
        pkg install --yes postgresql${TARGET_VERSION}-contrib
    fi
}

# zparseopts flags:
# -F: Fail if unrecognized options are found
# -D: Remove recognized options from positional parameters
# -E: Stop at first unrecognized option (don't error on unknown options)
# -K: Keep existing array values if option not present (vs clearing array)
# -a: Store options in array _opts
# -A: Store options with arguments in associative array _opts_args
zparseopts -F -D -E -K -a _opts -A _opts_args \
    s:=SOURCE_VERSION_OPTION \
    t:=TARGET_VERSION_OPTION

SOURCE_VERSION=${SOURCE_VERSION_OPTION[2]}
TARGET_VERSION=${TARGET_VERSION_OPTION[2]}

if [ -z ${SOURCE_VERSION+x} ]; then
    usage
fi

if [ -z ${TARGET_VERSION+x} ]; then
    usage
fi

if [ "${SOURCE_VERSION}" = "${TARGET_VERSION}" ]; then
    error "Source version and target version are the same."
fi

message "Upgrading PostgreSQL from ${SOURCE_VERSION} to ${TARGET_VERSION}"

export POSTGRES_USER=postgres
export TEMPLATE_DATABASE=template1

export PGPREFIX_SOURCE=/tmp/postgresql${SOURCE_VERSION}-server
export PGPREFIX_TARGET=/tmp/postgresql${TARGET_VERSION}-server

if [ -e ${PGPREFIX_SOURCE} ]; then
    rm -r -f ${PGPREFIX_SOURCE}
fi

if [ -e ${PGPREFIX_TARGET} ]; then
    rm -r -f ${PGPREFIX_TARGET}
fi

export SOURCE_BINDIR=${PGPREFIX_SOURCE}/usr/local/bin
export TARGET_BINDIR=${PGPREFIX_TARGET}/usr/local/bin

export SOURCE_LIBDIR=${PGPREFIX_SOURCE}/usr/local/lib
export TARGET_LIBDIR=${PGPREFIX_TARGET}/usr/local/lib

export PGHOME=/var/db/postgres

# Detect an explicit postgresql_data override in rc.conf. A non-empty value
# means the admin pinned a custom data directory; the base rc.conf has no such
# key and sysrc does not evaluate the rc script's built-in default.
_rc_pgdata=$(sysrc -n postgresql_data 2>/dev/null || :)

if [ -n "${_rc_pgdata}" ]; then
    POSTGRES_DATA_CUSTOMIZED=1

    if [[ ${_rc_pgdata:t} != data${SOURCE_VERSION} ]]; then
        error "postgresql_data (${_rc_pgdata}) does not end in data${SOURCE_VERSION}; cannot derive target path."
    fi

    _rc_pgdata_target=${_rc_pgdata%data${SOURCE_VERSION}}data${TARGET_VERSION}

    # Tilde-preserving raw forms for rc.conf; expanded forms for the filesystem.
    export SOURCE_PGDATA=${~_rc_pgdata}
    export TARGET_PGDATA=${~_rc_pgdata_target}
else
    POSTGRES_DATA_CUSTOMIZED=0
    export SOURCE_PGDATA=${PGHOME}/data${SOURCE_VERSION}
    export TARGET_PGDATA=${PGHOME}/data${TARGET_VERSION}
fi

if [ ! -d ${SOURCE_PGDATA} ]; then
    error "Source data directory does not exist"
fi

if [ -e ${TARGET_PGDATA} ]; then
    error "Target data directory already exists"
fi

# For a standby, verify SSH to the primary works before doing any real work: the
# base backup path relies on it to copy SSL material the backup cannot carry.
if ! postgresql-is-main ${SOURCE_PGDATA}; then
    _primary_host=$(primary-conninfo-field host "$(primary-conninfo)")

    if [ -z "${_primary_host}" ]; then
        error "Source cluster is a standby but primary_conninfo defines no host."
    fi

    check-primary-ssh "${_primary_host}"
fi

message "Fetching packages for version ${SOURCE_VERSION} (server)"
fetch-package postgresql${SOURCE_VERSION}-server
message "Fetching packages for version ${SOURCE_VERSION} (contrib)"
fetch-package postgresql${SOURCE_VERSION}-contrib
message "Fetching packages for version ${SOURCE_VERSION} (client)"
fetch-package postgresql${SOURCE_VERSION}-client

message "Fetching packages for version ${TARGET_VERSION} (server)"
fetch-package postgresql${TARGET_VERSION}-server
message "Fetching packages for version ${TARGET_VERSION} (contrib)"
fetch-package postgresql${TARGET_VERSION}-contrib
message "Fetching packages for version ${TARGET_VERSION} (client)"
fetch-package postgresql${TARGET_VERSION}-client

message "Extracting packages for version ${SOURCE_VERSION}"
mkdir -p ${PGPREFIX_SOURCE}
extract-package ${PGPREFIX_SOURCE} postgresql${SOURCE_VERSION}-server
extract-package ${PGPREFIX_SOURCE} postgresql${SOURCE_VERSION}-contrib
extract-package ${PGPREFIX_SOURCE} postgresql${SOURCE_VERSION}-client

message "Extracting packages for version ${TARGET_VERSION}"
mkdir -p ${PGPREFIX_TARGET}
extract-package ${PGPREFIX_TARGET} postgresql${TARGET_VERSION}-server
extract-package ${PGPREFIX_TARGET} postgresql${TARGET_VERSION}-contrib
extract-package ${PGPREFIX_TARGET} postgresql${TARGET_VERSION}-client

message "Fetching remaining packages"
pkg upgrade --yes --fetch-only --glob postgresql\*

# ===

# errreturn only returns from the enclosing function, and there is no enclosing
# function here, so an aborted step would otherwise fall through to the package
# upgrade and to starting a cluster that was never built. Check each step.
if postgresql-is-main ${SOURCE_PGDATA}; then
    message "Source cluster is in primary mode"
    perform-pg-upgrade || error "The upgrade of the primary cluster failed."
else
    message "Source cluster is in standby mode"
    perform-pg-basebackup || error "The rebuild of the standby cluster failed."
fi

perform-package-upgrade || error "The package upgrade failed."

if [ "${POSTGRES_DATA_CUSTOMIZED}" = "1" ]; then
    message "Updating postgresql_data in rc.conf to ${_rc_pgdata_target}"
    sysrc postgresql_data=${_rc_pgdata_target}
fi

message "Starting database"
service postgresql onestart

message "Removing temporary files"
rm -r -f ${PGPREFIX_SOURCE}
rm -r -f ${PGPREFIX_TARGET}

message "Previous data is available in ${SOURCE_PGDATA}."
